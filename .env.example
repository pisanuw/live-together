# WCV — environment variables
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# ---- Supabase ----
# WCV runs on the SHARED "upvoteme" Supabase project. To avoid clashing with
# other apps in that project, all WCV tables live in the `wcv` Postgres schema
# and all WCV storage buckets are prefixed `wcv-`.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Prefer the modern publishable key (sb_publishable_...); the legacy anon JWT
# also works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — used in Server Actions / Edge Functions. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres schema that WCV owns (do not change).
WCV_DB_SCHEMA=wcv
# Project-global storage buckets are namespaced for WCV.
SUPABASE_STORAGE_BUCKET=wcv-forum-media

# ---- App ----
# Base URL used for auth redirects and outgoing email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (transactional notifications via Resend) ----
RESEND_API_KEY=
AUTH_FROM_EMAIL=no-reply@example.com

# ---- Web Push (added in a later stage) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- Optional: observability ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# NOTE: Google OAuth client ID/secret are configured in the Supabase dashboard
# (Auth > Providers > Google), NOT here. Set the redirect URL to
# ${NEXT_PUBLIC_SITE_URL}/auth/callback for local, preview, and production.
